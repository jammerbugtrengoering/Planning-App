{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "supabase/**",
    "netlify/**",
    "tjek-tdz.mjs",
    "loenberegning.test.mjs",
    "opgavetid.test.mjs",
    "aftalerytme.test.mjs",
    "ugevalg.test.mjs",
    "portefoelje.test.mjs",
    "hentalle.test.mjs",
    "dubletter.test.mjs",
    "indlaesning.test.mjs"
  ],
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "globals": {
    "__BYGGET__": "readonly"
  }
}
